# =============================================================================
# GTC Code -- single shared environment file
# Copy to `.env` at the repo root and fill in real values. Never commit `.env`.
# Every Python and Node project reads this ONE file (gtc_common/env.py,
# load-root-env.cjs), whatever folder a script is started from.
# Paths may be absolute or relative to the repo root.
# Lists use | as the separator.  Full reference: docs/ENV.md
# =============================================================================

# --- Postgres (every Python project) -----------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=GTC
PG_USER=postgres
PG_PASSWORD=

# --- Logging: each script writes <LOG_DIR>/<script>.log -----------------------
LOG_DIR=logs

# --- Sales ETL (gtc-sales-etl) -------------------------------------------------
# Folders holding the store order exports (every *.csv in them is loaded)
SQUARE_ORDERS_CSV_DIR='data/import dump (square)'
SHOPIFY_ORDERS_CSV_DIR='data/import dump (shopify)'

# --- Expenses ETL (gtc-expenses-etl) -------------------------------------------
AMEX_BP_CSV_DIR='data/amex/Business Platinum'
AMEX_AB_CSV_DIR='data/amex/Amazon Business Prime'
# Business Platinum rows for these card members are excluded
AMEX_EXCLUDE_CARD_MEMBERS=FIRST LAST|FIRST2 LAST2
# Rows with these exact descriptions (card payments) are excluded
AMEX_EXCLUDE_DESCRIPTIONS=AUTOPAY PAYMENT - THANK YOU|MOBILE PAYMENT - THANK YOU

# --- Formatted pivot tables (gtc-pivot-tables) ---------------------------------
PIVOT_INPUT_CSV_DIR='data/CSV input(files deleted at end of process)'
PIVOT_OUTPUT_DIR='scripts/scripts output/ETL_to_table_daily_output'

# --- Reports -------------------------------------------------------------------
# gtc-royalties-csv: folder with one quarter's Square (orders-*.csv) and Shopify (orders_export*.csv) exports
ROYALTY_INPUT_DIR='data/royalty report copys/Affinity_Q3_2026'
# Where royalty reports are written (gtc-royalties-csv, gtc-royalties-db, gtc-upi-names)
ROYALTY_OUTPUT_DIR='scripts/scripts output/Royalties Roports'
# Optional second copy of the royalty report (leave empty to skip)
ROYALTY_COPY_DIR=
# gtc-upi-names: Affinity royalty report CSVs to read
AFFINITY_REPORT_FILES='data/royalty report copys/Q1.csv|data/royalty report copys/Q2.csv'
# gtc-tax-report: folder with orders_export*.csv, *royalty_report*.csv and an orders-* Square sub-folder
TAX_INPUT_DIR='data/yearly tax reporting'
TAX_OUTPUT_FILE='scripts/scripts output/Yearly Tax Reporting.csv'

# --- Affinity image scraper (gtc-affinity-images) ------------------------------
IMAGE_URLS_FILE='scripts/scripts input/Images_urls.txt'
IMAGE_OUTPUT_DIR='scripts/scripts output/webscrapping/images'

# --- Shopify: gtc-graphql-api (embedded OAuth app, Shopify CLI convention) -----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=
SHOP_CUSTOM_DOMAIN=
NODE_ENV=development
PORT=
FRONTEND_PORT=
HOST=

# --- Shopify: shopify-graphql-retrieve-orders (static Admin API token) ---------
# A different auth mechanism from the OAuth app above.
SHOPIFY_SHOP=yourstore.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2025-10
