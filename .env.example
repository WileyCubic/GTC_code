# ============================================================
# GTC Code — single shared environment file
# Copy this file to `.env` (repo root) and fill in real values.
# Every project in this repo loads its config from this ONE file,
# regardless of which folder a script is launched from.
# ============================================================

# ============================================================
# SHARED / DATABASE
# (Data-Pipelines, Analysis-Bashboard, GTC-Formated-Privot-Tables)
# ============================================================
Mysql_host=
Mysql_user=
Mysql_password=
Mysql_database=
SQLite_database=
square_raw=
shopify_raw=
lineitem_analysis=

# ============================================================
# DATA-PIPELINES / SALES_ETL
# ============================================================
Master_sales_log=
Master_expences_log=
raw_orders_log=
lineitem_analysis_log=
Backup_log=
# Primary_log / Secondary_log are only used as fallback defaults if
# Sales_ETL's setup_logging() is ever called with no explicit paths --
# every current call site passes explicit paths, so these are optional.
Primary_log=
Secondary_log=
ELT_Sales_to_DB_square_CSV_input=
ETL_Sales_to_DB_shopify_CSV_input=
lineitem_analysis_query=
Sales_ETL_lineitem_patterns=
square_raw_data=
shopify_raw_data=

# ============================================================
# DATA-PIPELINES / EXPENCES_ETL
# ============================================================
ETL_Expences_to_DB_log_file=
ETL_Expences_to_DB_BP_CSV_input=
ETL_Expences_to_DB_AB_CSV_input=
Card_Member_1=
Card_Member_2=
Card_Member_3=
Card_Member_4=
PMT_Line_1=
PMT_Line_2=

# ============================================================
# ANALYSIS-BASHBOARD
# ============================================================
Dashboard_log_file=
Dashboard_query_all=
aquery1=
aquery2=
aquery3=
aquery4=
aquery5=
aquery6=
aquery7=
aquery8=
aquery9=
aquery10=
Query_log_file=

# ============================================================
# GTC-FORMATED-PRIVOT-TABLES
# ============================================================
ETL_to_table_daily_log_file=
ETL_to_table_daily_csv_input=
ETL_to_table_daily_output=
GTC_formated_tables_patterns=

# ============================================================
# SCRIPTS
# ============================================================
q1_2025=
q2_2025=
q3_2025=
q4_2025=
Royalty_report_out_dir=
image_url_file=
Images_urls_output=

# ============================================================
# SHOPIFY -- gtc-graphql-api (embedded OAuth app, Shopify CLI convention)
# ============================================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=
SHOP_CUSTOM_DOMAIN=
NODE_ENV=development
PORT=3000
FRONTEND_PORT=8002
HOST=

# ============================================================
# SHOPIFY -- shopify-graphql-retrieve-orders
# (static Admin API access token, NOT the OAuth app above -- a different
# auth mechanism entirely, kept as its own vars on purpose)
# ============================================================
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
shopify-graphql-order-query=
